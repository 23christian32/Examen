meta {
  name: 01 - Create Report
  type: http
  seq: 1
}
post {
  url: {{baseUrl}}/reports
  body: multipartForm
  auth: none
}
body:multipart-form {
  address: Calle 1, frente a la escuela
  description: Fuga grande de agua
  severity: high
  reporterPhone: 5551234567
  photo: @file(./foto-fuga.jpg)
}
docs {
  Selecciona una foto local JPEG, PNG o WebP en el campo photo antes de enviar.
  Espera 201 con photoUrl. Sin archivo: 400. Maximo 5 MB.
}
