DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=waterleaksdb
PORT=3000

# SMTP (Ethereal: corre "npm run ethereal:create" para generar una cuenta de
# prueba gratuita y pegar aqui host/usuario/password que te imprima el script)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Municipio - Fugas de Agua <no-reply@municipio.gob>"

# Correo de la cuadrilla de mantenimiento que recibe el aviso de cada reporte
MAINTENANCE_EMAIL=cuadrilla@municipio.gob

AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
DOCKER_USER=
